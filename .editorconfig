root = true

[*.{kt,kts}]
max_line_length = 120
ij_wrap_on_typing = false
ij_kotlin_call_parameters_wrap = off
ij_kotlin_method_parameters_wrap = off
ij_kotlin_method_call_chain_wrap = off
ij_kotlin_extends_list_wrap = off
ij_kotlin_assignment_wrap = off
ij_kotlin_wrap_expression_body_functions = 0
ij_kotlin_wrap_elvis_expressions = 0
ij_kotlin_line_break_after_multiline_when_entry = false
ij_kotlin_field_annotation_wrap = off
ij_kotlin_method_parameters_new_line_after_left_paren = false
ij_kotlin_method_parameters_right_paren_on_new_line = false
ij_kotlin_call_parameters_new_line_after_left_paren = false
ij_kotlin_call_parameters_right_paren_on_new_line = false
ij_kotlin_align_multiline_parameters = true
ij_kotlin_align_multiline_parameters_in_calls = false
ij_kotlin_blank_lines_before_declaration_with_comment_or_annotation_on_separate_line = 0
ij_kotlin_continuation_indent_size = 4
ij_kotlin_continuation_indent_for_expression_bodies = false
ij_kotlin_continuation_indent_in_elvis = false
ij_kotlin_continuation_indent_in_if_conditions = false
ij_kotlin_continuation_indent_in_argument_lists = false
ij_kotlin_continuation_indent_in_parameter_lists = false
ij_kotlin_continuation_indent_for_chained_calls = false
ij_kotlin_packages_to_use_import_on_demand = unset

[*.java]
max_line_length = 120
ij_wrap_on_typing = false
ij_java_field_annotation_wrap = off
ij_java_method_annotation_wrap = off
ij_java_blank_lines_around_method = 0
ij_java_call_parameters_wrap = off
ij_java_method_parameters_wrap = off
