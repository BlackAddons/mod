uniform float2 res;
uniform float t;
uniform float amt;
uniform float2 look;
uniform float density;
uniform float3 top;
uniform float3 bottom;
uniform float3 navy;
uniform float3 violet;
uniform float3 plum;
uniform float3 rose;

const int RIDGES = 72;
const float TOP = 0.42;
const float GAP = 0.0128;
const float RISE = 0.25;
const int REACH = 22;

float hash(float2 p) {
    float2 q = fract(p * float2(0.1373, 0.2531) + float2(0.4142, 0.7321));
    return fract((q.x + 3.7) * (q.y + 9.1) * (q.x + q.y + 5.3) * 17.39);
}

float noise(float2 p) {
    float2 i = floor(p);
    float2 f = fract(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash(i), hash(i + float2(1, 0)), u.x), mix(hash(i + float2(0, 1)), hash(i + float2(1, 1)), u.x), u.y);
}

float rise(float x, float fi, float pace) {
    float n = smoothstep(0.2, 0.9, noise(float2(x * 2.2 + 11.0, fi * 0.15 + pace * 0.22)));
    float detail = 0.85 + 0.15 * sin(x * 9.0 + fi * 0.7 - pace * 1.3);
    return RISE * exp(-x * x * 2.2) * n * detail;
}

half4 main(float2 frag) {
    float2 pos = frag + look;
    float x = (pos.x - 0.5 * res.x) / res.y;
    float y = (0.5 * res.y - pos.y) / res.y;
    float tt = mod(t, 1000.0);
    float pace = tt * 0.35;
    float aa = 1.0 / (res.y * density);
    float halfWidth = max(0.0011 - aa * 0.5, 0.0);

    float v = clamp(pos.y / res.y, 0.0, 1.0);
    float3 hue = mix(mix(violet, plum, clamp(x + 0.5, 0.0, 1.0)), rose, v * 0.6);

    int front = int(min(float(RIDGES - 1), floor((TOP + RISE - y) / GAP)));
    float lines = 0.0;
    float clear = 1.0;
    for (int k = 0; k < REACH; k++) {
        int i = front - k;
        if (i < 0) break;
        float fi = float(i);
        float h = rise(x, fi, pace);
        float d = y - (TOP - fi * GAP + h);
        float line = 1.0 - smoothstep(halfWidth, halfWidth + aa, abs(d));
        float below = 1.0 - smoothstep(-halfWidth - aa, -halfWidth, d);
        lines += clear * line * (0.5 + 0.5 * fi / float(RIDGES)) * (0.6 + 0.4 * h / RISE);
        clear *= 1.0 - max(line, below);
        if (clear < 0.01) break;
    }

    float k = amt * mix(1.0, 0.45, v);
    float3 col = mix(top, bottom, v);
    col = mix(col, navy, 0.5 * min(1.0, k * 2.2));
    col = mix(col, hue, clamp(lines, 0.0, 1.0) * min(1.0, k * 2.5));

    float2 px = floor(frag * density);
    float n = hash(px + fract(tt * 0.61) * 97.0) + hash(px.yx + fract(tt * 0.37) * 53.0) - 1.0;
    col += n / 255.0 * 1.5;
    return half4(half3(col), 1.0);
}
